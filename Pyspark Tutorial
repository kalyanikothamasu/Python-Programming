spark.catalog.listTables()


# =============================================================================
# SECTION 3 – DML  (Data Manipulation Language)
# =============================================================================
print("\n" + "="*60)
print("SECTION 3 – DML")
print("="*60)

# ── 3.1 SELECT & filter ───────────────────────────────────────────────────────
# Use case: Pull active engineers earning above $90k
print("\n[3.1] Active engineers > $90k:")
emp_clean.select("name", "dept", "salary", "seniority") \
    .filter((F.col("dept") == "Engineering") &
            (F.col("salary") > 90000) &
            (F.col("is_active") == True)) \
    .orderBy(F.col("salary").desc()) \
    .show()

# ── 3.2 isin / isNull / isNotNull / between ───────────────────────────────────
# Use case: Filter to selected departments, exclude nulls, apply salary band
print("\n[3.2] isin / isNotNull / between:")
emp_clean.filter(
    F.col("dept").isin(["Engineering", "Finance"]) &
    F.col("salary").isNotNull() &
    F.col("salary").between(85000, 120000)
).select("name", "dept", "salary").show()

# ── 3.3 All join types ─────────────────────────────────────────────────────────
print("\n[3.3] JOIN types:")

# INNER – only rows that match in both DataFrames
print("  Inner join:")
emp_clean.join(dept, on="dept", how="inner") \
    .select("name", "dept", "salary", "manager", "office") \
    .show(5)

# LEFT – all employees, nulls for depts with no match
print("  Left join:")
emp_clean.join(dept, on="dept", how="left") \
    .select("name", "dept", "office") \
    .show(5)

# RIGHT – all departments including 'Legal' which has no employees
print("  Right join (shows Legal with no staff):")
emp_clean.join(dept, on="dept", how="right") \
    .select("name", "dept", "office") \
    .show()

# FULL OUTER – everything from both sides
print("  Full outer join:")
emp_clean.join(dept, on="dept", how="full") \
    .select("name", "dept", "office") \
    .show(5)

# LEFT SEMI – employees whose dept exists in dept table (like IN subquery)
print("  Left semi join:")
emp_clean.join(dept, on="dept", how="left_semi") \
    .select("name", "dept").show(5)

# LEFT ANTI – employees whose dept does NOT exist in dept table
print("  Left anti join:")
emp_clean.join(dept, on="dept", how="left_anti") \
    .select("name", "dept").show()

# BROADCAST – force small table to be broadcast (avoids shuffle)
print("  Broadcast join (perf optimisation):")
emp_clean.join(F.broadcast(dept), on="dept", how="inner") \
    .select("name", "dept", "manager").show(3)

# ── 3.4 Union / intersect / except ────────────────────────────────────────────
# Use case: Combine two regional datasets; find records unique to one source
print("\n[3.4] Union / intersect / except:")
eng = emp_clean.filter(F.col("dept") == "Engineering").select("name", "dept", "salary")
fin = emp_clean.filter(F.col("dept") == "Finance").select("name", "dept", "salary")

eng.unionByName(fin).show()             # stack rows, match by column name
eng.union(fin).show()                   # stack rows, match by position

# ── 3.5 Sort / limit / distinct / deduplicate ─────────────────────────────────
print("\n[3.5] Sort / limit / dropDuplicates:")
emp_clean.orderBy(F.desc("salary"), F.asc("name")).limit(5).show()
emp_clean.select("dept").distinct().show()
emp_clean.dropDuplicates(["dept", "gender"]).select("dept", "gender", "name").show()

# ── 3.6 Null handling ─────────────────────────────────────────────────────────
# Use case: Replace null salaries with dept average before ML feature engineering
print("\n[3.6] Null handling:")
emp_clean.fillna({"salary": 0.0, "dept": "Unknown"}).show(3)
emp_clean.dropna(how="any", subset=["salary"]).show(3)
emp_clean.withColumn(
    "salary_safe", F.coalesce(F.col("salary"), F.lit(0.0))
).select("name", "salary", "salary_safe").show(5)

# ── 3.7 Pivot table ───────────────────────────────────────────────────────────
# Use case: Cross-tab of dept × gender headcount for diversity report
print("\n[3.7] Pivot (dept × gender headcount):")
emp_clean.groupBy("dept").pivot("gender", ["F", "M"]).count().show()

# ── 3.8 Unpivot (stack) ───────────────────────────────────────────────────────
# Use case: Normalise wide monthly-revenue columns back to rows for time-series analysis
print("\n[3.8] Unpivot (wide → long):")
wide = emp_clean.select("name", "salary", "annual_bonus")
# Simulate via selectExpr stack (compatible with Spark 3.x)
wide.selectExpr(
    "name",
    "stack(2, 'salary', salary, 'bonus', annual_bonus) as (metric, value)"
).show(6)


# =============================================================================
# SECTION 4 – AGGREGATE FUNCTIONS
# =============================================================================
print("\n" + "="*60)
print("SECTION 4 – AGGREGATE FUNCTIONS")
print("="*60)

# ── 4.1 Core groupBy + agg ────────────────────────────────────────────────────
# Use case: HR payroll summary by department
print("\n[4.1] Payroll summary by dept:")
emp_clean.groupBy("dept").agg(
    F.count("*").alias("headcount"),
    F.count("salary").alias("non_null_salaries"),
    F.countDistinct("gender").alias("gender_count"),
    F.sum("salary").alias("total_payroll"),
    F.avg("salary").alias("avg_salary"),
    F.min("salary").alias("min_salary"),
    F.max("salary").alias("max_salary"),
    (F.max("salary") - F.min("salary")).alias("salary_range"),
    F.round(F.stddev_samp("salary"), 2).alias("salary_stddev"),
    F.round(F.variance("salary"), 2).alias("salary_variance"),
    F.collect_list("name").alias("all_employees"),
    F.collect_set("seniority").alias("seniority_levels"),
    F.first("name", ignorenulls=True).alias("first_hire_alpha"),
    F.last("name",  ignorenulls=True).alias("last_hire_alpha"),
).orderBy("dept").show(truncate=False)

# ── 4.2 Approximate aggregations (production scale) ───────────────────────────
# Use case: Count distinct users in a billion-row event log cheaply
print("\n[4.2] Approximate stats:")
emp_clean.agg(
    F.approx_count_distinct("name", rsd=0.01).alias("approx_unique_employees"),
    F.percentile_approx("salary", 0.5).alias("median_salary"),
    F.percentile_approx("salary", [0.25, 0.75, 0.90, 0.99]).alias("salary_percentiles"),
    F.round(F.corr("salary", "experience_yrs"), 4).alias("salary_exp_correlation"),
    F.round(F.covar_samp("salary", "experience_yrs"), 2).alias("covariance"),
    F.round(F.skewness("salary"), 4).alias("skewness"),
    F.round(F.kurtosis("salary"), 4).alias("kurtosis"),
).show(truncate=False)

# ── 4.3 ROLLUP – hierarchical subtotals ──────────────────────────────────────
# Use case: Finance report with dept totals + grand total row
print("\n[4.3] Rollup (dept subtotals + grand total):")
emp_clean.rollup("dept", "gender").agg(
    F.sum("salary").alias("total_salary"),
    F.grouping_id("dept", "gender").alias("grouping_level"),  # 0=leaf, 1=dept, 3=grand
).orderBy("grouping_level", "dept").show()

# ── 4.4 CUBE – all combination subtotals ─────────────────────────────────────
# Use case: Multi-dimensional sales cube for OLAP drill-down
print("\n[4.4] Cube (dept × gender all combos):")
emp_clean.cube("dept", "gender").agg(
    F.count("*").alias("headcount"),
    F.avg("salary").alias("avg_salary"),
).orderBy("dept", "gender").show()

# ── 4.5 HAVING equivalent ────────────────────────────────────────────────────
# Use case: Only show depts with avg salary above $85k and at least 2 staff
print("\n[4.5] HAVING equivalent (filter after agg):")
(emp_clean.groupBy("dept")
    .agg(F.avg("salary").alias("avg_sal"), F.count("*").alias("cnt"))
    .filter((F.col("avg_sal") > 85000) & (F.col("cnt") >= 2))
    .orderBy(F.desc("avg_sal"))
    .show())


# =============================================================================
# SECTION 5 – WINDOW FUNCTIONS
# =============================================================================
print("\n" + "="*60)
print("SECTION 5 – WINDOW FUNCTIONS")
print("="*60)

# Window specs
w_sal    = Window.partitionBy("dept").orderBy(F.col("salary").desc())
w_full   = Window.partitionBy("dept")                                 # no ordering → whole partition
w_rows   = w_sal.rowsBetween(Window.unboundedPreceding, Window.currentRow)
w_slide  = w_sal.rowsBetween(-1, 1)                                   # 3-row rolling window
w_global = Window.orderBy(F.col("salary").desc())                     # no partition → global

# ── 5.1 Ranking ───────────────────────────────────────────────────────────────
# Use case: Assign bonus tiers — top earner per dept gets Tier 1
print("\n[5.1] Ranking functions:")
emp_clean.filter(F.col("salary").isNotNull()).withColumn(
    "rank",        F.rank().over(w_sal)          # gaps on ties
).withColumn(
    "dense_rank",  F.dense_rank().over(w_sal)    # no gaps on ties
).withColumn(
    "row_number",  F.row_number().over(w_sal)    # unique, no ties
).withColumn(
    "ntile_4",     F.ntile(4).over(w_sal)        # salary quartile within dept
).withColumn(
    "pct_rank",    F.round(F.percent_rank().over(w_sal), 3)
).withColumn(
    "cume_dist",   F.round(F.cume_dist().over(w_sal), 3)
).select("name","dept","salary","rank","dense_rank","row_number","ntile_4","pct_rank").show()

# ── 5.2 Top-N per group ───────────────────────────────────────────────────────
# Use case: Send promotion email to top 2 earners in each department
print("\n[5.2] Top-2 earners per dept:")
(emp_clean.filter(F.col("salary").isNotNull())
    .withColumn("rn", F.row_number().over(w_sal))
    .filter(F.col("rn") <= 2)
    .select("dept","name","salary","rn")
    .orderBy("dept","rn")
    .show())

# ── 5.3 Lag / Lead ────────────────────────────────────────────────────────────
# Use case: Calculate salary delta vs previous and next employee in dept
print("\n[5.3] Lag / Lead:")
emp_clean.filter(F.col("salary").isNotNull()).withColumn(
    "prev_salary",  F.lag("salary", 1, 0.0).over(w_sal)
).withColumn(
    "next_salary",  F.lead("salary", 1, 0.0).over(w_sal)
).withColumn(
    "delta_prev",   F.round(F.col("salary") - F.col("prev_salary"), 2)
).select("name","dept","salary","prev_salary","next_salary","delta_prev").show()

# ── 5.4 Running aggregates ────────────────────────────────────────────────────
# Use case: Cumulative payroll spend as new employees are hired (sorted by salary desc)
print("\n[5.4] Running / cumulative aggregates:")
emp_clean.filter(F.col("salary").isNotNull()).withColumn(
    "running_payroll",  F.sum("salary").over(w_rows)
).withColumn(
    "running_avg",      F.round(F.avg("salary").over(w_rows), 2)
).withColumn(
    "dept_total",       F.sum("salary").over(w_full)
).withColumn(
    "pct_of_dept",      F.round(F.col("salary") / F.sum("salary").over(w_full) * 100, 1)
).select("name","dept","salary","running_payroll","dept_total","pct_of_dept").show()

# ── 5.5 Sliding / rolling window ─────────────────────────────────────────────
# Use case: 3-row rolling average salary (smooth out outliers in ranking)
print("\n[5.5] 3-row rolling average:")
emp_clean.filter(F.col("salary").isNotNull()).withColumn(
    "rolling_avg_3", F.round(F.avg("salary").over(w_slide), 2)
).withColumn(
    "rolling_max_3", F.max("salary").over(w_slide)
).select("name","dept","salary","rolling_avg_3","rolling_max_3").show()

# ── 5.6 First / Last value ────────────────────────────────────────────────────
# Use case: Tag every row with the highest earner's name in the same dept
print("\n[5.6] First / Last in partition:")
emp_clean.filter(F.col("salary").isNotNull()).withColumn(
    "dept_top_earner", F.first("name").over(w_sal)   # first after ordering by salary desc
).withColumn(
    "dept_lowest",     F.last("name").over(w_rows)
).select("name","dept","salary","dept_top_earner","dept_lowest").show()

# ── 5.7 Window on sales data (time-series) ────────────────────────────────────
# Use case: Month-over-month revenue change per employee
print("\n[5.7] Sales MoM delta per employee:")
sales_ts = sales.withColumn("sale_date", F.to_date("sale_date"))
w_emp_time = Window.partitionBy("emp_id").orderBy("sale_date")
sales_ts.withColumn(
    "prev_amount", F.lag("amount", 1).over(w_emp_time)
).withColumn(
    "mom_delta", F.round(F.col("amount") - F.col("prev_amount"), 2)
).withColumn(
    "cum_revenue", F.round(F.sum("amount").over(
        w_emp_time.rowsBetween(Window.unboundedPreceding, Window.currentRow)), 2)
).show()


# =============================================================================
# SECTION 6 – STRING FUNCTIONS
# =============================================================================
print("\n" + "="*60)
print("SECTION 6 – STRING FUNCTIONS")
print("="*60)

str_data = [
    (1, "  Alice Johnson  ", "alice.johnson@company.com", "Engineering | Senior | SF"),
    (2, "BOB SMITH",         "BOB.SMITH@COMPANY.COM",     "Marketing | Mid | NYC"),
    (3, "carol  lee",        "carol.lee@gmail.com",        "HR | Junior | Chicago"),
    (4, "Dave O'Brien",      "dave.obrien@co.uk",          "Finance | Principal | Boston"),
]
str_df = spark.createDataFrame(str_data, ["id", "name", "email", "metadata"])

# ── 6.1 Case & whitespace ─────────────────────────────────────────────────────
# Use case: Normalise free-text name fields from multiple source systems
print("\n[6.1] Case & whitespace normalisation:")
str_df.withColumn("name_lower",   F.lower(F.trim("name"))) \
      .withColumn("name_upper",   F.upper(F.trim("name"))) \
      .withColumn("name_initcap", F.initcap(F.trim("name"))) \
      .withColumn("email_lower",  F.lower("email")) \
      .select("id", "name", "name_lower", "name_initcap", "email_lower") \
      .show(truncate=False)

# ── 6.2 Substring / position / length ────────────────────────────────────────
# Use case: Extract domain from email; get initials from name
print("\n[6.2] Substring / position / length:")
str_df.withColumn("name_clean",  F.initcap(F.trim("name"))) \
      .withColumn("first_name",  F.split(F.trim("name"), " ").getItem(0)) \
      .withColumn("last_name",   F.split(F.trim("name"), " ").getItem(1)) \
      .withColumn("email_user",  F.substring_index("email", "@", 1)) \
      .withColumn("email_domain",F.substring_index("email", "@", -1)) \
      .withColumn("name_len",    F.length(F.trim("name"))) \
      .withColumn("at_position", F.instr("email", "@")) \
      .select("id","first_name","last_name","email_user","email_domain","name_len","at_position") \
      .show(truncate=False)

# ── 6.3 Split / concat / format ──────────────────────────────────────────────
# Use case: Parse pipe-delimited metadata column; build display labels
print("\n[6.3] Split / concat / format:")
str_df.withColumn("parts",      F.split("metadata", " \\| ")) \
      .withColumn("dept_parsed",F.col("parts").getItem(0)) \
      .withColumn("level",      F.col("parts").getItem(1)) \
      .withColumn("city",       F.col("parts").getItem(2)) \
      .withColumn("label",      F.concat_ws(" – ", F.initcap(F.trim("name")), F.col("parts").getItem(1))) \
      .withColumn("formatted",  F.format_string("ID-%03d: %s", F.col("id"), F.initcap(F.trim("name")))) \
      .select("id","dept_parsed","level","city","label","formatted") \
      .show(truncate=False)

# ── 6.4 Replace / translate / pad / repeat ────────────────────────────────────
# Use case: Mask PII, align columns in fixed-width report, sanitise text
print("\n[6.4] Replace / pad / repeat:")
str_df.withColumn("masked_email", F.regexp_replace("email", r"(?<=.{2})[^@]+(?=@)", "***")) \
      .withColumn("padded_id",    F.lpad(F.col("id").cast("string"), 6, "0")) \
      .withColumn("padded_name",  F.rpad(F.initcap(F.trim("name")), 20, ".")) \
      .withColumn("sep",          F.repeat("-", 10)) \
      .withColumn("reversed",     F.reverse(F.initcap(F.trim("name")))) \
      .select("id","masked_email","padded_id","padded_name","sep","reversed") \
      .show(truncate=False)

# ── 6.5 Hashing & encoding ────────────────────────────────────────────────────
# Use case: Anonymise email PII using SHA-256 for GDPR compliance
print("\n[6.5] Hashing & encoding:")
str_df.withColumn("sha256",   F.sha2(F.lower("email"), 256)) \
      .withColumn("md5_hash", F.md5(F.lower("email"))) \
      .withColumn("b64",      F.base64(F.encode("email", "utf-8"))) \
      .select("id","email","sha256","md5_hash","b64") \
      .show(truncate=False)

# ── 6.6 levenshtein / soundex (fuzzy matching) ───────────────────────────────
# Use case: Find near-duplicate names in a customer table
print("\n[6.6] Levenshtein / soundex:")
names_df = spark.createDataFrame([
    ("Alice", "Alise"),("Robert","Roberto"),("John","Jon"),("Carol","Karl")
], ["name_a","name_b"])
names_df.withColumn("edit_dist", F.levenshtein("name_a","name_b")) \
        .withColumn("soundex_a", F.soundex("name_a")) \
        .withColumn("soundex_b", F.soundex("name_b")) \
