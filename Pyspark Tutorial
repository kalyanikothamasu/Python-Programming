# Use case: Normalise salary column using vectorised pandas operations
import pandas as pd
from pyspark.sql.functions import pandas_udf

@pandas_udf(DT())
def normalise_salary(s: pd.Series) -> pd.Series:
    """Min-max normalise within the batch."""
    return (s - s.min()) / (s.max() - s.min() + 1e-9)

