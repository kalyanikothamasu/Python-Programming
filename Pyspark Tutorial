# ── 14.1 Cache / persist ─────────────────────────────────────────────────────
# Use case: Cache a heavily reused DataFrame (e.g., dimension table) in memory
from pyspark import StorageLevel

emp_clean.cache()                                # MEMORY_AND_DISK by default
emp_clean.persist(StorageLevel.MEMORY_AND_DISK)  # explicit
emp_clean.count()                                # trigger materialisation
print("[14.1] DataFrame cached. Partitions:", emp_clean.rdd.getNumPartitions())
emp_clean.unpersist()                            # release when done

# ── 14.2 Repartition vs coalesce ─────────────────────────────────────────────
# Use case: Repartition by join key before a large join to avoid data skew
df_rep = emp_clean.repartition(4, "dept")        # full shuffle, balanced
df_coal = emp_clean.coalesce(2)                  # reduce partitions, no shuffle
print("[14.2] Repartitioned:", df_rep.rdd.getNumPartitions(),
      "| Coalesced:", df_coal.rdd.getNumPartitions())

# ── 14.3 Broadcast join ───────────────────────────────────────────────────────
# Use case: Join a 10B-row fact table with a 1000-row dimension without shuffling
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", "50mb")
result_bc = emp_clean.join(F.broadcast(dept), on="dept", how="left")
print("[14.3] Broadcast join complete. Row count:", result_bc.count())

# ── 14.4 Explain / query plan ─────────────────────────────────────────────────
# Use case: Inspect whether Spark chose a broadcast join or sort-merge join
print("\n[14.4] Query plan (simple):")
emp_clean.filter(F.col("salary") > 80000).explain(mode="simple")

# ── 14.5 Salting (skew mitigation) ───────────────────────────────────────────
# Use case: 90% of rows have dept="Engineering" — salt the key to spread the load
print("\n[14.5] Salted join to handle data skew:")
import random
num_salts = 4

skewed = emp_clean.withColumn(
    "salt_key",
    F.concat(F.col("dept"), F.lit("_"), (F.rand(42) * num_salts).cast("int").cast("string"))
)
dept_salted = dept.withColumn(
    "salt",  F.explode(F.array([F.lit(i) for i in range(num_salts)]))
).withColumn(
    "salt_key", F.concat(F.col("dept"), F.lit("_"), F.col("salt").cast("string"))
)
result_salted = skewed.join(dept_salted, on="salt_key", how="left") \
                      .drop("salt_key","salt")
print("  Salted join rows:", result_salted.count())

