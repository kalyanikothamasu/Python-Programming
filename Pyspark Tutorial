# ── 12.1 Single CTE via SQL ───────────────────────────────────────────────────
# Use case: Dept summary then rank – avoid repeating the groupBy
print("\n[12.1] Single CTE – dept salary ranking:")
spark.sql("""
    WITH dept_stats AS (
        SELECT dept,
               COUNT(*)         AS headcount,
               ROUND(AVG(salary),2) AS avg_salary,
               MAX(salary)      AS max_salary,
               MIN(salary)      AS min_salary
        FROM employees
        WHERE salary IS NOT NULL
        GROUP BY dept
    )
    SELECT *,
           RANK() OVER (ORDER BY avg_salary DESC) AS salary_rank
    FROM dept_stats
    ORDER BY salary_rank
""").show()

# ── 12.2 Chained CTEs ────────────────────────────────────────────────────────
# Use case: Tag top earner per dept; enrich with dept manager
print("\n[12.2] Chained CTEs – top earner per dept + manager lookup:")
spark.sql("""
    WITH ranked AS (
        SELECT name, dept, salary,
               ROW_NUMBER() OVER (PARTITION BY dept ORDER BY salary DESC) AS rn
        FROM employees
        WHERE salary IS NOT NULL
    ),
    top_earners AS (
        SELECT name, dept, salary FROM ranked WHERE rn = 1
    ),
    with_manager AS (
        SELECT t.name, t.dept, t.salary, d.manager, d.office
        FROM top_earners t
        LEFT JOIN departments d ON t.dept = d.dept
    )
    SELECT dept, name AS top_earner, salary, manager, office
    FROM with_manager
    ORDER BY salary DESC
""").show()

# ── 12.3 CTE with aggregation filter (HAVING equivalent) ─────────────────────
# Use case: Find depts where max earner earns 30%+ above dept average
print("\n[12.3] CTE + HAVING – depts with high salary spread:")
spark.sql("""
    WITH dept_agg AS (
        SELECT dept,
               ROUND(AVG(salary),2) AS avg_sal,
               MAX(salary)          AS max_sal,
               COUNT(*)             AS cnt
        FROM employees
        WHERE salary IS NOT NULL
        GROUP BY dept
    )
    SELECT dept, avg_sal, max_sal, cnt,
           ROUND((max_sal - avg_sal) / avg_sal * 100, 1) AS pct_above_avg
    FROM dept_agg
    WHERE cnt >= 2
      AND max_sal > avg_sal * 1.1
    ORDER BY pct_above_avg DESC
""").show()

