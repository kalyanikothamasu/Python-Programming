# ── Employees ────────────────────────────────────────────────────────────────
emp_data = [
    (1,  "Alice",   "Engineering", "F", 95000.0,  7, "2017-03-15", True),
    (2,  "Bob",     "Marketing",   "M", 72000.0,  5, "2019-06-01", True),
    (3,  "Carol",   "Engineering", "F", 115000.0, 9, "2015-01-20", True),
    (4,  "Dave",    "HR",          "M", 68000.0,  2, "2022-08-10", True),
    (5,  "Eve",     "Marketing",   "F", 80000.0,  4, "2020-11-05", True),
    (6,  "Frank",   "Engineering", "M", 99000.0,  6, "2018-05-22", False),
    (7,  "Grace",   "HR",          "F", 73000.0,  3, "2021-02-14", True),
    (8,  "Hank",    "Finance",     "M", 88000.0,  8, "2016-09-30", True),
    (9,  "Iris",    "Finance",     "F", 91000.0,  6, "2018-12-01", True),
    (10, "Jack",    "Marketing",   "M", 65000.0,  1, "2023-04-17", True),
    (11, "Karen",   "Engineering", "F", None,      3, "2021-07-08", True),   # null salary
