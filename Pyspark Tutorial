    StructField("hire_date", StringType(),   True),   # kept as string to demo casting
    StructField("is_active", BooleanType(),  True),
])
emp = spark.createDataFrame(emp_data, emp_schema)

# ── Departments ───────────────────────────────────────────────────────────────
dept_data = [
    ("Engineering", "Alice M",  "San Francisco", 500000.0),
    ("Marketing",   "Bob K",    "New York",       300000.0),
    ("HR",          "Carol L",  "Chicago",        150000.0),
    ("Finance",     "Dave R",   "Boston",         400000.0),
    ("Legal",       "Eve S",    "New York",       200000.0),   # no employees → tests outer join
]
dept = spark.createDataFrame(
    dept_data, ["dept", "manager", "office", "budget"]
)

# ── Sales (for date & window demos) ──────────────────────────────────────────
sales_data = [
    (1, 1, "Laptop",    1200.0, "2024-01-05"),
    (2, 2, "Phone",      800.0, "2024-01-12"),
    (3, 1, "Tablet",     450.0, "2024-02-03"),
    (4, 3, "Laptop",    1350.0, "2024-02-14"),
    (5, 2, "Monitor",    350.0, "2024-03-01"),
    (6, 1, "Keyboard",   120.0, "2024-03-18"),
    (7, 4, "Phone",      900.0, "2024-04-02"),
    (8, 3, "Tablet",     500.0, "2024-04-20"),
    (9, 1, "Monitor",    370.0, "2024-05-07"),
    (10,5, "Laptop",    1100.0, "2024-05-25"),
]
sales = spark.createDataFrame(
    sales_data, ["sale_id", "emp_id", "product", "amount", "sale_date"]
)


# =============================================================================
# SECTION 2 – DDL  (Data Definition Language)
# =============================================================================
print("\n" + "="*60)
print("SECTION 2 – DDL")
print("="*60)

# ── 2.1 Explicit schema & printSchema ─────────────────────────────────────────
# Use case: Validate schema of raw ingestion data before processing
print("\n[2.1] Schema:")
emp.printSchema()

# ── 2.2 Add / rename / drop / cast columns ────────────────────────────────────
# Use case: Derive calculated columns and fix data types from raw CSV strings
emp_clean = (
    emp
    .withColumn("hire_date",  F.to_date("hire_date", "yyyy-MM-dd"))         # cast string → date
    .withColumn("annual_bonus", F.round(F.col("salary") * 0.12, 2))        # derived column
    .withColumn("seniority",
        F.when(F.col("yrs_exp") >= 8, "Principal")
         .when(F.col("yrs_exp") >= 5, "Senior")
         .when(F.col("yrs_exp") >= 2, "Mid")
         .otherwise("Junior"))
    .withColumnRenamed("yrs_exp", "experience_yrs")                         # rename
    .withColumn("salary",     F.col("salary").cast(DoubleType()))            # explicit cast
)
print("\n[2.2] Cleaned schema after DDL transforms:")
emp_clean.printSchema()

# ── 2.3 Temp views & SQL tables ───────────────────────────────────────────────
# Use case: Register DataFrame as SQL table so analysts can query with spark.sql()
emp_clean.createOrReplaceTempView("employees")
dept.createOrReplaceTempView("departments")
sales.createOrReplaceTempView("sales")

# ── 2.4 Create managed table (writes to default warehouse) ────────────────────
# Use case: Persist a DataFrame as a Hive/Spark catalog table for cross-job reuse
# emp_clean.write.mode("overwrite").saveAsTable("analytics.employees")  # uncomment in cluster

# ── 2.5 Write as partitioned Parquet ─────────────────────────────────────────
