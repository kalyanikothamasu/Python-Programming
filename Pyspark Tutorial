# Use case: Tokenise a text column (e.g., job titles) into a word list
from pyspark.sql.types import ArrayType

@F.udf(ArrayType(StringType()))
def tokenise(text):
    if text is None: return []
    import re
    return re.sub(r"[^a-zA-Z0-9 ]", "", text.lower()).split()

print("\n[13.3] UDF returning Array – tokenise dept name:")
emp_clean.withColumn("tokens", tokenise(F.col("dept"))) \
         .select("name","dept","tokens").show()

